{
  "name": "@gerdr/chat",
  "version": "0.1.0",
  "description": "gerdr's chat UI for coding agents (ACP): conversation, composer, tool calls, permission / question cards, rewind, interjections. Fed by an event log (chatlog in github.com/gerdr-dev/gerdr).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/gerdr-dev/gerdr.git",
    "directory": "ui/packages/chat"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "sonner": ">=2"
  },
  "dependencies": {
    "@radix-ui/react-use-controllable-state": "1.3.0",
    "ai": "6.0.316",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff": "8.0.2",
    "lucide-react": "0.525.0",
    "motion": "14.6.0",
    "radix-ui": "1.8.1",
    "react-virtuoso": "4.18.19",
    "streamdown": "2.7.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8"
  }
}
